# Google Maps Platform key with "Places API (New)" enabled.
# Used server-side only (never sent to the browser).
GOOGLE_MAPS_API_KEY=

# Optional: if set, adding / activating / deactivating dishes requires this PIN.
ADMIN_PIN=

# Operator / data controller shown on the Privacy & Terms pages (required by
# Vietnam's Law on Personal Data Protection 91/2025/QH15 — fill before launch).
OPERATOR_NAME=
OPERATOR_EMAIL=
OPERATOR_ADDRESS=


# Cloudflare R2 Public Development URL
NEXT_PUBLIC_R2_PUBLIC_URL=


