# Google Maps Platform key with "Places API (New)" enabled.
# Used server-side only (never sent to the browser).
GOOGLE_MAPS_API_KEY=

# Optional: if set, adding / activating / deactivating dishes requires this PIN.
ADMIN_PIN=

# Operator / data controller shown on the Privacy & Terms pages (required by
# Vietnam's Law on Personal Data Protection 91/2025/QH15 — fill before launch).
OPERATOR_NAME=
OPERATOR_EMAIL=
OPERATOR_ADDRESS=


# Cloudflare R2 Public Development URL
NEXT_PUBLIC_R2_PUBLIC_URL=



# Dish list storage (Cloudflare R2, S3 API). Required on Vercel/serverless:
# their file system is read-only, so without these, adding or toggling dishes
# can't be saved. Locally (unset) the app uses data/dishes.json.
# Create the token in Cloudflare → R2 → Manage API tokens → "Object Read & Write"
# (limit it to this bucket). Server-side only — never prefix with NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: object key for the list (default data/dishes.json).
# R2_DISHES_KEY=
